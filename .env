async def dummy_lookup(client, message):
    await message.reply_text(
        "❌ **Demo Mode Active!**\n\n"
        "Yeh bot sirf ek dashboard dikhane ke liye hai. "
        "Isme asli data database se nahi aa raha kyunki yeh script backend APIs se link nahi hai.\n\n"
        "⚡ **Powered By @frexxxy**"
    )

# ---------- MY ID COMMAND ----------
@app.on_message(filters.command("myid"))
async def get_my_id(client, message):
    await message.reply_text(f"👤 **Your Telegram ID:** `{message.from_user.id}`")


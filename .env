# ---------- START COMMAND ----------
@app.on_message(filters.command("start"))
async def start_command(client, message):
    user_id = message.from_user.id
    
    # Buttons Create Karna
    buttons = InlineKeyboardMarkup([
        [
            InlineKeyboardButton("📋 View All Commands", callback_data="show_commands"),
            InlineKeyboardButton("👤 My ID", callback_data="my_id")
        ],
        [
            InlineKeyboardButton("📞 Contact Admin", url="https://t.me/frexxxy")
        ]
    ])

    # Message Send Karna
    await message.reply_text(
        f"👋 **Welcome, {message.from_user.first_name}!**\n\n"
        f"Main hu **{BOT_NAME}**, ek advanced Database Lookup bot.\n"
        f"Mujhe group mein bhi use kar sakte ho! Niche diye gaye buttons se commands dekho.\n\n"
        f"{DASHBOARD_TEXT}",
        reply_markup=buttons,
        disable_web_page_preview=True
    )

# ---------- CALLBACK HANDLER (Buttons click karne par) ----------
@app.on_callback_query()
async def button_handler(client, callback_query: CallbackQuery):
    if callback_query.data == "show_commands":
        await callback_query.message.edit_text(
            f"📢 **Available Commands:**\n\n{DASHBOARD_TEXT}",
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("🔙 Go Back", callback_data="back_home")]
            ])
        )
        await callback_query.answer()
        
    elif callback_query.data == "my_id":
        await callback_query.message.reply_text(f"👤 **Aapki Telegram User ID:** `{callback_query.from_user.id}`")
        await callback_query.answer()
        
    elif callback_query.data == "back_home":
        await callback_query.message.edit_text(
            f"👋 **Welcome Back!**\n\n{DASHBOARD_TEXT}",
            reply_markup=InlineKeyboardMarkup([
                [
                    InlineKeyboardButton("📋 View All Commands", callback_data="show_commands"),
                    InlineKeyboardButton("👤 My ID", callback_data="my_id")
                ],
                [
                    InlineKeyboardButton("📞 Contact Admin", url="https://t.me/frexxxy")
                ]
            ])
        )
        await callback_query.answer()

